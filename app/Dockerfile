# syntax=docker/dockerfile:1.7
#
# Multi-stage build for the orders-api demo service.
#
# Stage 1 compiles a statically linked binary with the build metadata baked in.
# Stage 2 copies that binary onto a distroless base so the final image contains
# the binary, CA certificates and nothing else — no shell, no package manager,
# no libc to CVE-scan. Attack surface you did not ship cannot be exploited.
#
# Build (into minikube's docker daemon, so no registry is needed):
#   minikube -p minikube docker-env | Invoke-Expression      # PowerShell
#   eval $(minikube docker-env)                              # bash
#   docker build -t orders-api:0.1.0 ./app
#
# scripts/deploy-app.ps1 and scripts/deploy-app.sh do exactly this.

# ---------------------------------------------------------------------------
# Stage 1 — build
# ---------------------------------------------------------------------------
FROM golang:1.23-alpine AS build

# Build arguments. Supplied by the deploy scripts; sensible defaults here so a
# bare `docker build` still works.
ARG VERSION=0.1.0
ARG COMMIT=dev
ARG TARGETOS=linux
ARG TARGETARCH=amd64

WORKDIR /src

# Copy the module files first and download dependencies as their own layer.
# Source changes then do not invalidate the (slow) dependency download.
COPY go.mod ./
# go.sum is generated by `go mod tidy`; the wildcard keeps the build working
# whether or not it has been committed yet.
COPY go.su[m] ./
RUN go mod download

# Now the source.
COPY . .

# CGO_ENABLED=0 produces a static binary, which is what lets us use a
# distroless *static* base in stage 2.
#   -s -w        strip the symbol table and DWARF data (smaller image)
#   -X main.var  inject build metadata, surfaced as the app_build_info metric
#   -trimpath    remove local filesystem paths from the binary (reproducibility)
RUN CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} \
    go build \
      -trimpath \
      -ldflags="-s -w -X main.version=${VERSION} -X main.commit=${COMMIT}" \
      -o /out/orders-api \
      .

# Run the unit tests as part of the build so a broken instrumentation contract
# (for example a missing le="0.3" histogram bucket) fails the image build rather
# than silently shipping.
RUN go test ./... 2>&1 | tail -20

# ---------------------------------------------------------------------------
# Stage 2 — runtime
# ---------------------------------------------------------------------------
# `nonroot` variant runs as uid/gid 65532 and has no shell. Combined with
# readOnlyRootFilesystem and a dropped capability set in the Deployment, this is
# about as locked down as a container gets without a custom seccomp profile.
FROM gcr.io/distroless/static-debian12:nonroot

# OCI image annotations. These are what `docker inspect`, registries and supply
# chain tooling (Trivy, Syft, cosign attestations) read.
LABEL org.opencontainers.image.title="orders-api" \
      org.opencontainers.image.description="Instrumented demo service emitting RED metrics, OpenTelemetry traces and trace-correlated JSON logs." \
      org.opencontainers.image.source="https://github.com/fakhfakhahmed/k8s-observability-stack" \
      org.opencontainers.image.documentation="https://github.com/fakhfakhahmed/k8s-observability-stack/blob/main/README.md" \
      org.opencontainers.image.licenses="MIT" \
      org.opencontainers.image.authors="Ahmed Fakhfakh" \
      org.opencontainers.image.vendor="Ahmed Fakhfakh"

# Re-declare the ARGs — ARGs do not cross stage boundaries.
ARG VERSION=0.1.0
ARG COMMIT=dev
LABEL org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${COMMIT}"

COPY --from=build /out/orders-api /usr/local/bin/orders-api

# 65532 is the `nonroot` user baked into the distroless image. Declaring it here
# means the container still refuses to run as root even if the Pod spec forgets
# to set runAsNonRoot.
USER 65532:65532

EXPOSE 8080

# No HEALTHCHECK instruction: in Kubernetes the kubelet owns liveness and
# readiness via the probes in app/k8s/deployment.yaml. A Docker HEALTHCHECK here
# would be dead weight that the cluster ignores.

ENTRYPOINT ["/usr/local/bin/orders-api"]
